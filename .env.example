# ==============================================================================
# Frontend Safe Environment Variables (Vite)
# ==============================================================================
# NUNCA coloque chaves secretas (GEMINI_API_KEY, senhas MySQL ou tokens privados)
# com o prefixo VITE_. Todas as chaves sensíveis devem ficar apenas no servidor
# backend PHP (/backend-php-example/api/config.php ou variáveis de ambiente do servidor).

# URL base da API REST (PHP/MySQL no cPanel ou proxy local). Padrão: /api
VITE_API_BASE_URL="/api"

# Ambiente da aplicação ('development' | 'staging' | 'production')
VITE_APP_ENV="production"

# Base pública de assets do Vite ('./' para compatibilidade com subpastas e raízes no cPanel, ou '/')
VITE_BASE_PATH="./"

# Opcional: Chave pública do Google Maps JS restrita por HTTP Referrer (fortmidia.com.br / fortnews.com.br)
VITE_GOOGLE_MAPS_API_KEY=""
